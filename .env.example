# 复制为 .env；仅保存非敏感配置。
# 密钥放在 ~/.codex/env/private.env，变量名 DEEPSEEK_API_KEY。
MODEL_API_BASE_URL=https://api.deepseek.com
MODEL_API_MODEL=deepseek-v4-pro

# 报名表单的非敏感默认值；不需要报名时可忽略。
EASYDATA_COURSE_NAME="Easy Data × AI"
EASYDATA_COURSE_RATING=5
# 上线自己的成果站后填写，例如 https://YOUR_NAME.github.io/YOUR_REPO/task{task}/
EASYDATA_NOTES_URL_TEMPLATE=
# 微信昵称、队名、群号和群内链接请按 docs/registration-config.md 配置。

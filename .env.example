# 复制为 .env；仅保存非敏感配置。
# 密钥放在 ~/.codex/env/private.env，变量名 DEEPSEEK_API_KEY。
MODEL_API_BASE_URL=https://api.deepseek.com
MODEL_API_MODEL=deepseek-v4-pro

# 报名表单的非敏感默认值；不需要报名时可忽略。
EASYDATA_COURSE_NAME="Easy Data × AI"
EASYDATA_COURSE_RATING=5
# 上线自己的成果站后填写，例如 https://YOUR_NAME.github.io/YOUR_REPO/task{task}/
EASYDATA_NOTES_URL_TEMPLATE=

# ===== 个人报名资料：以下仅为变量示例，保持注释 =====
# 将需要的变量复制到 ~/.codex/env/private.env，去掉行首 # 后填写自己的值。
# 不要在项目 .env 中启用这些个人字段，也不要覆盖私密文件已有配置。
# private.env 权限为 600，所在 ~/.codex/env 目录权限为 700。
# 必填：微信昵称、队名、群号、实际表单地址。
# EASYDATA_WECHAT_NICKNAME="你的微信昵称"
# EASYDATA_TEAM_NAME="你的队名"
# EASYDATA_GROUP_NAME="你的群号"
# EASYDATA_FORM_URL="https://你的实际表单地址"
# 可选：组队任务安排链接、证书昵称；证书昵称为空时使用“无”。
# EASYDATA_SCHEDULE_URL=
# EASYDATA_CERTIFICATE_NICKNAME=

# 配置后检查：python3 submission_config.py --check（只显示状态，不显示值）。
# 详细说明：docs/registration-config.md。
